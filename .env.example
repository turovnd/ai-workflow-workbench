# Copy only if .env does not exist. Replace the database password.
POSTGRES_PASSWORD=change-this-local-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
API_PORT=4010
WEB_PORT=4173
GENERATION_MODE=deterministic
ALLOW_LIVE_PROVIDER=false
LIVE_CALL_BUDGET=2
OPENROUTER_MODEL=openai/gpt-4.1-mini
# OPENROUTER_API_KEY is a server-only secret. Never use VITE_ for it.
# Set VITE_API_URL in the Vercel frontend build environment only.
# VITE_API_URL=https://workflow-api.b2p.space
# Exact verified reverse-proxy addresses/CIDRs. Default trusts no proxy.
TRUST_PROXY=
