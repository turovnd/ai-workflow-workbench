{
  "name": "ai-workflow-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @support-desk/web",
    "dev:api": "npm run dev -w @support-desk/api",
    "dev:worker": "npm run dev -w @support-desk/worker",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:web": "npm run build -w @support-desk/web",
    "build:server": "npm run build -w @support-desk/api && npm run build -w @support-desk/worker",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p backend/tsconfig.tests.json --noEmit && tsc -p frontend/tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:backend && npm run test -w @support-desk/web",
    "test:db": "tsx --test --test-concurrency=1 backend/tests/common/data/repositories/*.integration.test.ts backend/tests/modules/api/*/*.integration.test.ts backend/tests/modules/worker/*.integration.test.ts",
    "test:e2e": "npm run test:e2e -w @support-desk/web",
    "db:migrate": "npm run build:server && MIGRATIONS_DIR=backend/migrations node backend/modules/api/dist/migrate.mjs",
    "start:api": "npm run start -w @support-desk/api",
    "start:worker": "npm run start -w @support-desk/worker",
    "test:backend": "vitest run --config backend/vitest.config.ts",
    "api:generate": "node frontend/tools/generate-api.mjs",
    "api:check": "node frontend/tools/generate-api.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.0.3"
  },
  "workspaces": [
    "frontend",
    "backend/modules/*",
    "backend/common/*"
  ],
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "@fastify/static": {
      "content-disposition": "2.0.1"
    }
  }
}
