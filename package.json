{
  "name": "ai-workflow-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @support-desk/web",
    "dev:api": "npm run dev -w @support-desk/api",
    "dev:worker": "npm run dev -w @support-desk/worker",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:web": "npm run build -w @support-desk/web",
    "build:server": "npm run build -w @support-desk/api && npm run build -w @support-desk/worker",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "tsx --test --test-concurrency=1 tests/packages/data/src/repositories/*.integration.test.ts tests/apps/api/src/*/*.integration.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "npm run build:server && MIGRATIONS_DIR=packages/data/migrations node apps/api/dist/migrate.mjs",
    "start:api": "npm run start -w @support-desk/api",
    "start:worker": "npm run start -w @support-desk/worker"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
