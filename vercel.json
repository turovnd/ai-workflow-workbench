{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend/modules/api",
      "framework": "fastify",
      "entrypoint": "main.ts",
      "functions": {
        "main.ts": {
          "maxDuration": 120
        }
      }
    },
    "worker": {
      "root": "backend/modules/worker",
      "functions": {
        "api/replies.ts": {
          "maxDuration": 75,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "support-replies"
            }
          ]
        },
        "api/recovery.ts": {
          "maxDuration": 60,
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "support-maintenance"
            }
          ]
        }
      },
      "buildCommand": "npm run build:vercel"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "schedules": {
    "support-recovery": {
      "schedule": "*/30 * * * *",
      "jitter": 1,
      "topic": "support-maintenance"
    }
  }
}
